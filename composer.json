{
	"name": "drago-ex/application",
	"description": "Extension for Nette Framework, providing reusable UI components, alert types, and flash message handling.",
	"type": "library",
	"license": ["MIT"],
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"nette/application": "^3.1",
		"nette/security": "^3.1",
		"nette/di": "^3.1",
		"nette/utils": "^4.0",
		"nette/forms": "^3.1"
	},
	"suggest": {
		"drago-ex/translator": "Configures Latte translation support for bundled templates using translation macros."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"nette/bootstrap": "^3.2",
		"tracy/tracy": "^2.10",
		"phpstan/phpstan-nette": "^2.0"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"src/Drago/assets/latte": "app/Presentation/Accessory/Widget"
				}
			}
		}
	}
}
